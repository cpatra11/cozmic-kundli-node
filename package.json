{
  "name": "cozmic-rag-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:reset:push": "tsx scripts/reset-db.ts",
    "test:integration:typed": "tsx scripts/integration-typed-persistence.ts",
    "test:agent:decision-smoke": "tsx scripts/agent-decision-smoke.ts",
    "test:family:regression": "tsx scripts/family-regression.ts",
    "test:dasha:regression": "tsx scripts/dasha-regression.ts",
    "test:transit:regression": "tsx scripts/transit-regression.ts",
    "test:regression": "npm run test:agent:decision-smoke && npm run test:family:regression && npm run test:dasha:regression && npm run test:transit:regression"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1018.0",
    "@langchain/anthropic": "^1.3.25",
    "@langchain/core": "^1.1.36",
    "@langchain/google-genai": "^1.0.3",
    "@langchain/langgraph": "^1.2.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0",
    "google-auth-library": "^10.6.2",
    "jose": "^6.2.2",
    "pg": "^8.13.3",
    "redis": "^5.11.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
