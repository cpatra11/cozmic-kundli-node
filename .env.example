PORT=8787
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
FIREBASE_SERVICE_ACCOUNT_JSON=

BE1_CONFIG={"base_url":"http://localhost:9393/api","internal_api_key":"change-me-internal-key","request_timeout_ms":15000,"circuit_fail_threshold":5,"circuit_cooldown_ms":30000}

LLM_PROVIDER=deepseek-bedrock
LLM_DECISION_CONFIG={"enabled":true,"mode":"hybrid","route":true,"intent":true,"mini_scope":true,"fast_answer":true,"temporal":true,"scope_selector":true,"plan":true,"tool_selection":true,"refinement_router":true,"coverage":true,"response_policy":true,"shadow_mode":false}

AWS_REGION=us-east-1
GOOGLE_GENAI_MODEL=gemini-2.0-flash
BEDROCK_DEEPSEEK_PLANNER_MODEL_ID=
BEDROCK_DEEPSEEK_COMPOSER_MODEL_ID=
EMBEDDING_DIM=192

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cozmic_rag_agents
DATABASE_SSL_CA_PATH=
DATABASE_SSL_REJECT_UNAUTHORIZED=false
PG_CONFIG={"query_timeout_ms":120000,"connection_timeout_ms":5000}

REDIS_URL=rediss://localhost:6379
VALKEY_CONFIG={"enabled":true,"cooldown_ms":60000}

RATE_LIMIT_CONFIG={"window_ms":60000,"expensive_max":20}

QUOTA_CONFIG={"enabled":true,"pro":{"mini_requests":50,"pro_requests":50,"kundli_generations":10},"nonpro":{"mini_requests":5,"pro_requests":0,"kundli_generations":3}}

PRO_ENTITLEMENT_ID=pro

CACHE_CONFIG={"agent_ttl_seconds":300,"timing_ttl_seconds":21600}