PORT=8787
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Postgres (canonical storage for chat sessions, chart payloads, and grounding)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cozmic_rag_agents
DATABASE_SSL_CA_PATH=
DATABASE_SSL_REJECT_UNAUTHORIZED=
PG_QUERY_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Firebase auth verification (Firebase Admin SDK by default)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Firebase Admin credentials (preferred)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Existing astrology engine
BE1_BASE_URL=http://localhost:9393/api
BE1_INTERNAL_API_KEY=change-me-internal-key
BE1_REQUEST_TIMEOUT_MS=15000
BE1_CIRCUIT_FAIL_THRESHOLD=5
BE1_CIRCUIT_COOLDOWN_MS=30000

# LLM runtime placeholders
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
LLM_PROVIDER=deepseek-bedrock

# LLM decision-node controls (enabled by default)
LLM_DECISION_ROUTE_ENABLED=true
LLM_DECISION_INTENT_ENABLED=true
LLM_DECISION_PLAN_ENABLED=true
LLM_DECISION_COVERAGE_ENABLED=true
LLM_DECISION_RESPONSE_POLICY_ENABLED=true
LLM_DECISION_SHADOW_MODE=false

# Bedrock runtime
AWS_REGION=us-east-1
BEDROCK_DEEPSEEK_PLANNER_MODEL_ID=
BEDROCK_DEEPSEEK_COMPOSER_MODEL_ID=

EMBEDDING_DIM=192

# Optional: cap request payload size
MAX_AUDIO_BYTES=5242880

# Basic protection for expensive endpoints
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_EXPENSIVE_MAX=20

# RevenueCat webhook integration for subscription sync
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_PRO_ENTITLEMENT_ID=Cozmic Astrology Pro
