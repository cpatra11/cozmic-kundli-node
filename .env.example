PORT=8787
NODE_ENV=development

# CORS
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# Postgres (canonical storage for chat sessions, chart payloads, and grounding)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cozmic_rag_agents
DATABASE_SSL_CA_PATH=
DATABASE_SSL_REJECT_UNAUTHORIZED=

# Firebase auth verification (Firebase Admin SDK by default)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Firebase Admin credentials (preferred)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Existing astrology engine
BE1_BASE_URL=http://localhost:9393/api

# LLM runtime placeholders
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
EMBEDDING_DIM=192

# Optional: cap request payload size
MAX_AUDIO_BYTES=5242880
